  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A47B92",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#267A65"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#8F5BB7"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C23B61"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#C83D78"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#2876A8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#3F2940"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.variable",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#197C7C"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#197C7C"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8F5BB7"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#C83D78",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#267A65",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#A47B92",
    "string": "#267A65",
    "number": "#8F5BB7",
    "keyword": "#C23B61",
    "type": "#2876A8",
    "class": "#2876A8",
    "interface": "#2876A8",
    "enum": "#2876A8",
    "function": "#C83D78",
    "method": "#C83D78",
    "variable": "#3F2940",
    "parameter": "#3F2940",
    "property": "#197C7C",
    "enumMember": "#8F5BB7",
    "namespace": "#2876A8",
    "decorator": "#C83D78"
  }
}
